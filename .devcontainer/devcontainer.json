{
  "name": "GKE Emulator Kubernetes Learning Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/install.sh && echo '✅ postCreateCommand done'",
  "postStartCommand": "bash .devcontainer/scripts/start-emulator.sh && echo '✅ postStartCommand done'",
  "postAttachCommand": "echo '✅ Ready — run ./deploy-gke.sh to create the emulated GKE cluster'",

  "forwardPorts": [4588, 8060, 9090, 3000],
  "portsAttributes": {
    "4588": { "label": "floci-gcp emulator API", "onAutoForward": "silent" },
    "8060": { "label": "Gateway (Envoy port-forward)", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "3000": { "label": "Grafana / Dashboard", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "vs-kubernetes": {
          "vs-kubernetes.kubectl-path": "/usr/local/bin/kubectl"
        }
      }
    }
  },

  "remoteEnv": {
    "KUBECONFIG": "/home/vscode/.kube/config"
  }
}